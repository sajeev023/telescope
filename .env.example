# Telescope — Environment Variables
# Copy this file to .env.local and update values as needed.

# Active AI provider: gemini, groq, openai, or ollama
LLM_PROVIDER=gemini

# Google Gemini API (recommended — best free tier for hackathons)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=120000

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=120000

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=120000

# Ollama (Local AI)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=300000

# Request limits (server-side enforced)
# Maximum total characters across all uploaded files in one analysis.
# ~800K chars ≈ 200K tokens (Gemini 2.0 Flash context window).
MAX_TOTAL_CONTENT_CHARS=800000
# Maximum number of files accepted in a single /api/analyze request.
MAX_FILES=50

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ENABLE_ANALYTICS=false