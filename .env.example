# Telescope — Environment Variables
# Copy this file to .env.local and update values as needed.

# Ollama Cloud API (OpenAI-compatible)
# Get your API key from: https://ollama.com/settings/api-keys
OLLAMA_API_KEY=your_api_key_here
OLLAMA_BASE_URL=https://api.ollama.com/v1
OLLAMA_DEFAULT_MODEL=deepseek-v4-pro

# Optional: adjust timeout and retry behavior
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_RETRIES=2

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ENABLE_ANALYTICS=false
